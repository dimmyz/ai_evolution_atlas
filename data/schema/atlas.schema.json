{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Evolution Atlas canonical data (seed schema)",
  "type": "object",
  "required": [
    "sources",
    "entities",
    "milestones",
    "relations"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "source_class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_class": {
            "enum": [
              "primary",
              "research_dataset",
              "independent_report",
              "credible_reporting",
              "discovery_only"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "license_note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "entity_type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entity_type": {
            "enum": [
              "model",
              "paper",
              "technology",
              "organization",
              "person"
            ]
          },
          "name": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date",
          "date_precision",
          "category",
          "summary",
          "source_ids",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "date_precision": {
            "enum": [
              "day",
              "month",
              "year"
            ]
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "candidate",
              "verified",
              "rejected",
              "needs_review"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "confidence",
          "evidence_source_ids",
          "status"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "released_by",
              "authored_by",
              "successor_of",
              "same_family_as",
              "uses_architecture",
              "introduced_concept",
              "influenced_by",
              "integrated_into",
              "enabled_by",
              "contemporary_with"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "status": {
            "enum": [
              "candidate",
              "verified",
              "rejected",
              "needs_review"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
